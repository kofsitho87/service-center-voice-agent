# Example environment for the Example Device Care demo.
# Copy to .env and fill in only what you need. Never commit .env.
#
# Offline tests and scripted scenarios need NONE of these values.
# All business integrations (reservations, call context, SMS, staff transfer,
# trunk allocation, call-end events) are in-process fakes and cannot be pointed
# at real systems: requests to any non-fake host are blocked.

# --- Runtime -------------------------------------------------------------
ENV=local
# Caller identity required by the local voice/text consoles.
TEST_CALLER_IDENTITY=demo-caller-0001
# Optional: choose a synthetic dial_info file (defaults to src/dial_info/dial_info.voice.ko.yaml).
# DIAL_INFO_FILE=src/dial_info/dial_info.keypad.ko.yaml

# --- Live model providers (your own accounts; required only for live text/voice)
# Live text needs only OPENAI_API_KEY. Live voice also needs the keys below and LiveKit.
OPENAI_API_KEY=
# Live voice (src/dial_info/dial_info.voice.ko.yaml): ElevenLabs STT + Cartesia TTS
ELEVEN_API_KEY=
CARTESIA_API_KEY=

# --- LiveKit (your own project; required only for live voice) ------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Demo data and fault injection (optional) ----------------------------
# DEMO_DB_PATH=artifacts/demo.sqlite3
# DEMO_NOW=2026-11-16T09:30:00+09:00
# DEMO_FAULTS={"trunk": ["busy", "available"], "reservation_submit": "error"}
# REDIS_ADDR=localhost:6379   # unset = in-process fakeredis

# --- Optional tracing (off unless all three are set) ---------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
